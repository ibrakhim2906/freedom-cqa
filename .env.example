# Copy this file to .env. Keep the real key out of Git and chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
CQA_REASONING_EFFORT=medium
# Compact assessor; assessor-reviewed adds an independent review and adjudicates disagreements.
CQA_STRATEGY=assessor
CQA_MAX_OUTPUT_TOKENS=6000
CQA_TIMEOUT_SECONDS=120
# Conservative lifetime cost limit for this checkout; recorded in data/runtime/usage.sqlite3.
CQA_MAX_SPEND_USD=3.50
CQA_CONCURRENCY=3
